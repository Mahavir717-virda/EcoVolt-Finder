# ──────────────────────────────────────────
# ecoVolt-finder — root .gitignore
# ──────────────────────────────────────────

# Node / npm
node_modules/
dist/
build/
.cache/
refer frontend
# Expo / React Native
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# TypeScript
*.tsbuildinfo

# Environment — NEVER commit real secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ML model artifacts (except the small committed demo model)
*.pkl
*.joblib
*.h5
*.pt
*.onnx
!ml/app/demo_model.pkl

# Databases
*.sqlite
*.sqlite3
*.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Coverage
coverage/
.nyc_output/
htmlcov/

# Misc
*.bak
*.tmp
