{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@contracts/*": [
        "../contracts/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../contracts/**/*.ts",
    "../contracts/**/*.json"
  ]
}
