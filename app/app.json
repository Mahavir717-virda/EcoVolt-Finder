{
  "expo": {
    "name": "ecoVolt-finder",
    "slug": "ecovolt-finder",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "scheme": "ecovolt",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#0F172A",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecovolt.finder",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ecoVolt-finder needs your location to find nearby EV charging stations and calculate accurate travel costs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "package": "com.ecovolt.finder",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000",
      "useMocks": false,
      "googleMapsApiKey": "",
      "googleClientId": "",
      "googleAndroidClientId": "",
      "googleWebClientId": "",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "56fb073a-579d-4c0f-9637-5cac473791c7"
      }
    }
  }
}
