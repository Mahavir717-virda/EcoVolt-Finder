# ─── ecoVolt-finder / app — Environment Variables ───────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env (it is in .gitignore).

# Android Maps SDK key (restricted by package name + SHA-1).
# Only used for map display — NOT for routing/geocoding (those are server-side).
GOOGLE_MAPS_ANDROID_KEY=

# URL of the Node/Express backend
API_BASE_URL=http://localhost:4000

# Set to "true" to use /contracts/examples/*.json instead of hitting the network.
# Member 1: keep this "true" until the backend is ready.
USE_MOCKS=true
