# ─── ecoVolt-finder / server — Environment Variables ────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env (it is in .gitignore).

# PostgreSQL connection string
DATABASE_URL=postgresql://ecovolt:ecovolt_password@localhost:5432/ecovolt_db?schema=public

# JWT secrets — use long random strings (openssl rand -base64 32)
JWT_SECRET=super_secret_jwt_access_token_key_for_ecovolt_dev_only_change_in_prod
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_for_ecovolt_dev_only_change_in_prod

# URL of the ML/FastAPI microservice
ML_SERVICE_URL=http://localhost:8000

# Google Maps server-side key (restricted by IP).
# Used for Routes API, Distance Matrix, Geocoding.
# NEVER ship this key in the app.
GOOGLE_SERVER_KEY=dummy_google_server_key

# Port for the Express server
PORT=4000

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:19006,http://localhost:3000,http://localhost:8081

# Set to "development" or "production"
NODE_ENV=development
