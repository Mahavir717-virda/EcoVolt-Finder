# ─── ecoVolt-finder / server — Environment Variables ────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env (it is in .gitignore).

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/ecovolt

# JWT secrets — use long random strings (openssl rand -base64 32)
JWT_SECRET=
JWT_REFRESH_SECRET=

# URL of the ML/FastAPI microservice
ML_SERVICE_URL=http://localhost:8000

# Google Maps server-side key (restricted by IP).
# Used for Routes API, Distance Matrix, Geocoding.
# NEVER ship this key in the app.
GOOGLE_SERVER_KEY=

# Port for the Express server
PORT=4000

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:19006,http://localhost:3000

# Set to "development" or "production"
NODE_ENV=development
