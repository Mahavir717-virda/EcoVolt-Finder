# ─── ecoVolt-finder / ml — Environment Variables ─────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env (it is in .gitignore).

# Electricity Maps API token (get one at electricitymaps.com)
ELECTRICITY_MAPS_TOKEN=

# Google Maps server-side key (restricted by IP)
# Used for Routes API / Distance Matrix / Geocoding
GOOGLE_SERVER_KEY=

# Grid data mode: live | mock | hybrid
# hybrid = try live, fall back to cache, then mock (recommended for dev)
# mock   = never call external APIs (fully offline demo)
# live   = always call external APIs, fail loudly on error
GRID_MODE=hybrid

# Optional: India Energy Atlas / Grid-India token
INDIA_ATLAS_KEY=

# FastAPI host/port
HOST=0.0.0.0
PORT=8000

# CORS: comma-separated list of allowed origins for the Node service (M2)
ALLOWED_ORIGINS=http://localhost:3000

# Cache TTL for grid data (seconds)
GRID_CACHE_TTL_SEC=300

# Random seed for the deterministic mock generator (reproducible demos)
MOCK_SEED=42

# Logging format: console (coloured, for dev) | json (for production)
LOG_FORMAT=console
